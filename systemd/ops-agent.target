[Unit]
Description=Pi Ops Agent control plane
Documentation=file:/opt/pi-ops-agent/current/docs/operations.md
Wants=network-online.target ops-root-helper.service agentd-approval-reviewer.service agentd-plugin-lease-broker.service agentd-guardian.service ops-agentd.service agentd-client-gateway.service ops-agent-server.service ops-agent-healthcheck.timer
After=network-online.target

[Install]
WantedBy=multi-user.target
