[Unit]
Description=Pi Ops Agent control plane
Documentation=file:/opt/pi-ops-agent/current/docs/operations.md
Wants=network-online.target ops-root-helper.service ops-systemd-helper.service ops-agentd.service ops-agent-server.service ops-agent-healthcheck.timer
After=network-online.target

[Install]
WantedBy=multi-user.target
