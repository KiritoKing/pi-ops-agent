[Unit]
Description=Pi Ops Agent Proxmox VE-only privileged broker
Documentation=file:/opt/pi-ops-agent/current/docs/workloads/pve.md
ConditionFileIsExecutable=/usr/bin/pvesh
PartOf=ops-agent.target
Before=ops-agent-server.service
After=local-fs.target pve-cluster.service pvedaemon.service
Wants=pve-cluster.service pvedaemon.service
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ops-agent/runtime.env
ExecStart=/opt/pi-ops-agent/current/bin/ops-root-helper --domain=pve --socket=/run/ops-agent/helper/pve-root-helper.sock --socket-gid=${OPS_SERVER_GID} --state-dir=/var/lib/ops-agent/pve-root-helper --audit-file=/var/log/ops-agent/pve-root-helper/audit.jsonl --agent-uid=${OPS_SERVER_UID} --approver-uid=${OPS_APPROVER_UID} --target-policy=/etc/ops-agent/targets.json --approval-key-id=local-approver-v1 --approval-public-key=/etc/ops-agent/tls/approval.pub.pem --receipt-key-id=local-pve-receipt-v1 --receipt-private-key=/etc/ops-agent/broker-receipts/private/pve.key.pem
Restart=always
RestartSec=2s
UMask=0077

# This is a separate, PVE-only TCB. It deliberately does not weaken the core
# broker unit and its request-domain checks reject every non-PVE method.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Local pvesh mutation handlers write the pmxcfs mount. Keep the exception on
# the PVE-only broker; the core broker must not inherit it.
ReadWritePaths=/var/lib/ops-agent/pve-root-helper /var/log/ops-agent/pve-root-helper /run/ops-agent/helper /etc/pve
InaccessiblePaths=-/run/ops-agent/helper/root-helper.sock -/var/lib/ops-agent/root-helper -/var/log/ops-agent/root-helper -/var/lib/ops-agent/plugin-sources -/var/lib/ops-agent/plugins -/etc/ops-agent/broker-receipts/private/core.key.pem -/etc/ops-agent/approver -/etc/ops-agent/credentials -/etc/ops-agent/tls/ca.key -/etc/ops-agent/tls/agent.key -/etc/ops-agent/tls/observer.key -/etc/ops-agent/tls/server.key

[Install]
WantedBy=multi-user.target
