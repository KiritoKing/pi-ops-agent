[Unit]
Description=Pi Ops Agent same-UID semantic heartbeat guardian
Documentation=file:/opt/pi-ops-agent/current/docs/architecture.md
PartOf=ops-agent.target
Before=ops-agentd.service
After=local-fs.target
ConditionPathExists=/etc/ops-agent/agentd-guardian.json
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=ops-agent
Group=ops-agent
SupplementaryGroups=ops-agent-client
ExecStart=/opt/pi-ops-agent/current/bin/agentd-guardian --config=/etc/ops-agent/agentd-guardian.json
Restart=always
RestartSec=2s
TimeoutStopSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/pi-ops-agent /etc/ops-agent/agentd-guardian.json /run/ops-agent/agentd
InaccessiblePaths=-/etc/ops-agent/agentd.json -/etc/ops-agent/credentials -/etc/ops-agent/tls -/etc/ops-agent/workloads -/run/ops-agent/agentd/agentd.sock -/run/ops-agent/agentd/backend.sock -/run/ops-agent/helper -/var/lib/ops-agent -/var/log/ops-agent -/run/docker.sock -/var/run/docker.sock

[Install]
WantedBy=ops-agent.target
