[Unit]
Description=Read-only health report for Pi Ops Agent
Documentation=file:/opt/pi-ops-agent/current/docs/operations.md
After=ops-agent.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/pi-ops-agent/current/scripts/healthcheck.sh --strict
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/pi-ops-agent /etc/ops-agent /run/ops-agent /var/lib/ops-agent /var/log/ops-agent
