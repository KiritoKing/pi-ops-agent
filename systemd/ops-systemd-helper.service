[Unit]
Description=Pi Ops Agent systemd watchdog and read-only inspection helper
Documentation=file:/opt/pi-ops-agent/current/docs/architecture.md
PartOf=ops-agent.target
Before=ops-agentd.service
After=local-fs.target dbus.service
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ops-agent/runtime.env
ExecStart=/opt/pi-ops-agent/current/bin/ops-systemd-helper --socket=/run/ops-agent/helper/systemd-helper.sock --socket-gid=${OPS_AGENT_GID} --audit-file=/var/log/ops-agent/systemd-helper/audit.jsonl --agent-uid=${OPS_AGENT_UID} --agent-unit=ops-agentd.service --heartbeat-timeout=45s --check-interval=5s --restart-cooldown=20s --max-restarts=3 --restart-window=5m
Restart=always
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/ops-agent/helper /var/log/ops-agent/systemd-helper
ReadOnlyPaths=/opt/pi-ops-agent /etc/ops-agent

[Install]
WantedBy=ops-agent.target
