[Unit]
Description=Pi Ops Agent privileged root helper
Documentation=file:/opt/pi-ops-agent/current/docs/security-model.md
PartOf=ops-agent.target
Before=ops-agentd.service
After=local-fs.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ops-agent/runtime.env
ExecStart=/opt/pi-ops-agent/current/bin/ops-root-helper --domain=core --socket=/run/ops-agent/helper/root-helper.sock --socket-gid=${OPS_SERVER_GID} --state-dir=/var/lib/ops-agent/root-helper --audit-file=/var/log/ops-agent/root-helper/audit.jsonl --agent-uid=${OPS_SERVER_UID} --approver-uid=${OPS_APPROVER_UID} --target-policy=/etc/ops-agent/targets.json --approval-key-id=local-approver-v1 --approval-public-key=/etc/ops-agent/tls/approval.pub.pem --receipt-key-id=local-core-receipt-v1 --receipt-private-key=/etc/ops-agent/broker-receipts/private/core.key.pem --source-plugin-root=/var/lib/ops-agent/plugin-sources --source-plugin-registry=/var/lib/ops-agent/plugins --write-root=/etc --write-root=/opt
Restart=always
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_PTRACE CAP_SYS_BOOT CAP_SYS_TIME CAP_AUDIT_CONTROL CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYSLOG CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_PERFMON CAP_BPF CAP_CHECKPOINT_RESTORE
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/run/ops-agent/helper/pve-root-helper.sock -/var/lib/ops-agent/pve-root-helper -/var/log/ops-agent/pve-root-helper -/etc/pve -/etc/ops-agent/broker-receipts/private/pve.key.pem -/etc/ops-agent/approver -/etc/ops-agent/credentials -/etc/ops-agent/tls/ca.key -/etc/ops-agent/tls/agent.key -/etc/ops-agent/tls/observer.key -/etc/ops-agent/tls/server.key

[Install]
WantedBy=multi-user.target
