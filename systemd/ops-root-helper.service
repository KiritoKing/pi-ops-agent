[Unit]
Description=Pi Ops Agent privileged root helper
Documentation=file:/opt/pi-ops-agent/docs/security-model.md
PartOf=ops-agent.target
Before=ops-agentd.service
After=local-fs.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/ops-agent/runtime.env
ExecStart=/opt/pi-ops-agent/bin/ops-root-helper --socket=/run/ops-agent/helper/root-helper.sock --socket-gid=${OPS_AGENT_GID} --state-dir=/var/lib/ops-agent/root-helper --audit-file=/var/log/ops-agent/root-helper/audit.jsonl --agent-uid=${OPS_AGENT_UID} --approver-uid=${OPS_APPROVER_UID} --write-root=/etc --write-root=/opt
Restart=always
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_PTRACE CAP_SYS_BOOT CAP_SYS_TIME CAP_AUDIT_CONTROL CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYSLOG CAP_WAKE_ALARM CAP_BLOCK_SUSPEND CAP_PERFMON CAP_BPF CAP_CHECKPOINT_RESTORE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=ops-agent.target
