[Unit]
Description=Pi Ops Agent unprivileged agent daemon
Documentation=file:/opt/pi-ops-agent/current/README.md
PartOf=ops-agent.target
Requires=ops-root-helper.service ops-systemd-helper.service
After=ops-root-helper.service ops-systemd-helper.service network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=ops-agent
Group=ops-agent
WorkingDirectory=/var/lib/ops-agent
Environment=NODE_ENV=production
Environment=OPS_AGENT_CONFIG=/etc/ops-agent/agentd.json
LoadCredentialEncrypted=deepseek_api_key:/etc/ops-agent/credentials/deepseek_api_key.cred
ExecStart=/opt/pi-ops-agent/current/runtime/node /opt/pi-ops-agent/current/dist/agentd/index.js
Restart=always
RestartSec=3s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/ops-agent/agentd /var/lib/ops-agent/workspaces /var/lib/ops-agent/sessions /var/lib/ops-agent/registry /var/lib/ops-agent/machines /var/lib/ops-agent/pi /var/log/ops-agent/agentd
ReadOnlyPaths=/opt/pi-ops-agent /etc/ops-agent /run/ops-agent/helper
InaccessiblePaths=-/etc/ops-agent/workloads -/run/docker.sock -/var/run/docker.sock

[Install]
WantedBy=ops-agent.target
